    "form": {
      "status": "stable",
      "since": "0.4.1",
      "platforms": [
        "React"
      ],
      "platformNote": "standing non-port",
      "platformGuidance": {
        "Angular": {
          "type": "native-equivalent",
          "reason": "Angular ships its own form layer. ReactiveFormsModule gives the validation, state and submission handling that Form exists to wire up on React, and every @kinetixui/angular control implements ControlValueAccessor, so they bind to it directly. A KinetixUI form wrapper would be a second, worse form system."
        },
        "SwiftUI": {
          "type": "composition",
          "reason": "Form is react-hook-form glue with no native analogue. KinetixField and the platform's own state hold the same job."
        },
        "Compose": {
          "type": "composition",
          "reason": "Form is react-hook-form glue with no native analogue. KinetixField and the platform's own state hold the same job."
        },
        "Flutter": {
          "type": "composition",
          "reason": "Form is react-hook-form glue with no native analogue. KinetixField and the platform's own state hold the same job."
        }
      }
    },
