{
  "$schema": "https://kinetixui.com/schema/components-manifest.json",
  "$description": "Every KinetixUI component and where it is really implemented. platformDefinitions is the ONE place a platform is declared — its family (web/native), label, abbreviation and whether its catalogue is complete. Everything downstream (platform-parity.json, component-status.json, the website, CI guardrails) derives from this file; nothing re-declares the platform list. A component lists only platforms whose source actually exists — scripts/check-platform-source.mjs verifies that against the packages.",
  "platformDefinitions": {
    "React": {
      "family": "web",
      "label": "React",
      "abbr": "RE",
      "maturity": "stable",
      "catalogComplete": true,
      "package": "@kinetixui/ui",
      "dir": "packages/ui"
    },
    "Angular": {
      "family": "web",
      "label": "Angular",
      "abbr": "NG",
      "maturity": "preview",
      "catalogComplete": false,
      "package": "@kinetixui/angular",
      "dir": "packages/ui-angular"
    },
    "SwiftUI": {
      "family": "native",
      "label": "SwiftUI",
      "abbr": "SW",
      "maturity": "stable",
      "catalogComplete": true,
      "package": "KinetixUI",
      "dir": "packages/ui-swiftui"
    },
    "Compose": {
      "family": "native",
      "label": "Jetpack Compose",
      "abbr": "JC",
      "maturity": "stable",
      "catalogComplete": true,
      "package": "com.kinetixui:ui-compose",
      "dir": "packages/ui-compose"
    },
    "Flutter": {
      "family": "native",
      "label": "Flutter",
      "abbr": "FL",
      "maturity": "stable",
      "catalogComplete": true,
      "package": "kinetix_ui",
      "dir": "packages/ui-flutter"
    }
  },
