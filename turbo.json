{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:tokens": {
      "inputs": ["tokens/**", "style-dictionary/**"],
      "outputs": ["packages/tokens/dist/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:tokens"],
      "outputs": [
        "dist/**",
        "storybook-static/**",
        "apps/web/public/r/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "build:registry": {
      "dependsOn": ["build:tokens"],
      "inputs": ["registry/**", "packages/ui/src/**"],
      "outputs": ["apps/web/public/r/**"]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build", "build:tokens"] },
    "clean": { "cache": false },
    "storybook": { "cache": false, "persistent": true, "dependsOn": ["build:tokens"] }
  }
}
