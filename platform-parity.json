    "direction-provider": {
      "Angular": {
        "type": "native-equivalent",
        "reason": "The web platform already threads direction: set dir on an element and every descendant inherits it, and Angular CDK's Directionality reads that same attribute. @kinetixui/angular has no Radix-style provider to thread it through, so there is nothing for a component to add."
      },
      "SwiftUI": {
        "type": "native-equivalent",
        "reason": "SwiftUI carries layout direction in the environment. Set .environment(\\.layoutDirection, .rightToLeft) and every view below reads it — there is no provider to port."
      },
      "Compose": {
        "type": "native-equivalent",
        "reason": "Compose carries layout direction in a CompositionLocal. Provide LocalLayoutDirection and every composable below reads it — there is no provider to port."
      },
      "Flutter": {
        "type": "native-equivalent",
        "reason": "Flutter carries layout direction in the widget tree. Wrap a subtree in Directionality and every widget below reads it — there is no provider to port."
      }
    },
