    "Compose": {
      "family": "native",
      "label": "Jetpack Compose",
      "abbr": "JC",
      "maturity": "experimental",
      "catalogComplete": true,
      "package": "com.kinetixui:ui-compose",
      "dir": "packages/ui-compose",
      "distribution": {
        "channel": "Maven Central",
        "coordinate": "com.kinetixui:ui-compose",
        "published": false,
        "note": "publish-compose.yml stages to the Central Portal; it needs four signing/credential secrets and defaults to a dry run."
      }
    },
    "Flutter": {
      "family": "native",
      "label": "Flutter",
      "abbr": "FL",
      "maturity": "experimental",
      "catalogComplete": true,
      "package": "kinetix_ui",
      "dir": "packages/ui-flutter",
      "distribution": {
        "channel": "pub.dev",
        "coordinate": "kinetix_ui",
        "published": false,
        "note": "publish-flutter.yml publishes to pub.dev; it needs PUB_DEV_CREDENTIALS and defaults to a dry run."
      }
    }
  },
