{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "markdown-editor",
  "title": "Markdown Editor",
  "status": "stable",
  "since": "0.12.0",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {},
  "components": [
    {
      "name": "MarkdownEditor",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": false,
          "description": "the markdown source. Controlled: pass `onValueChange` with it."
        },
        {
          "name": "defaultValue",
          "type": "string",
          "required": false,
          "description": "starting markdown when the editor manages its own buffer. Ignored once `value` is passed."
        },
        {
          "name": "onValueChange",
          "type": "((value: string) => void)",
          "required": false,
          "description": "called with the full markdown after every edit — the name every other KinetixUI value control uses"
        },
        {
          "name": "placeholder",
          "type": "string",
          "required": false
        },
        {
          "name": "rows",
          "type": "number",
          "required": false
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/markdown-editor.tsx"
}
