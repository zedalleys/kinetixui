{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "file-upload",
  "title": "File Upload",
  "status": "stable",
  "since": "0.4.1",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {},
  "components": [
    {
      "name": "FileUpload",
      "props": [
        {
          "name": "multiple",
          "type": "boolean",
          "required": false
        },
        {
          "name": "accept",
          "type": "string",
          "required": false
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false
        },
        {
          "name": "helperText",
          "type": "React.ReactNode",
          "required": false
        },
        {
          "name": "buttonLabel",
          "type": "React.ReactNode",
          "required": false
        },
        {
          "name": "files",
          "type": "UploadFile[]",
          "required": false
        },
        {
          "name": "onFilesSelected",
          "type": "((files: File[]) => void)",
          "required": false
        },
        {
          "name": "onRemove",
          "type": "((id: string) => void)",
          "required": false
        },
        {
          "name": "onRetry",
          "type": "((id: string) => void)",
          "required": false
        }
      ]
    },
    {
      "name": "FileUploadItem",
      "props": [
        {
          "name": "file",
          "type": "UploadFile",
          "required": true
        },
        {
          "name": "onRemove",
          "type": "((id: string) => void)",
          "required": false
        },
        {
          "name": "onRetry",
          "type": "((id: string) => void)",
          "required": false
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/file-upload.tsx"
}
