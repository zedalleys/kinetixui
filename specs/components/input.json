{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "input",
  "title": "Input",
  "status": "stable",
  "since": "0.4.1",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {
    "state": [
      "Default",
      "Focus",
      "Error",
      "Disabled"
    ],
    "corners": [
      "sharp",
      "default",
      "rounded",
      "pill"
    ]
  },
  "components": [
    {
      "name": "Input",
      "props": [
        {
          "name": "state",
          "type": "\"Default\" | \"Focus\" | \"Disabled\" | \"Error\" | null",
          "required": false
        },
        {
          "name": "corners",
          "type": "\"default\" | \"sharp\" | \"pill\" | \"rounded\" | null",
          "required": false,
          "description": "corner style — matches the design source's Corners property"
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/input.tsx"
}
