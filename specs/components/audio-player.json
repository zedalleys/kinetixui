{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "audio-player",
  "title": "Audio Player",
  "status": "stable",
  "since": "0.4.1",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {},
  "components": [
    {
      "name": "AudioPlayer",
      "props": [
        {
          "name": "src",
          "type": "string",
          "required": true
        },
        {
          "name": "variant",
          "type": "\"full\" | \"mini\"",
          "required": false
        },
        {
          "name": "title",
          "type": "string",
          "required": false
        },
        {
          "name": "artist",
          "type": "string",
          "required": false
        },
        {
          "name": "coverSrc",
          "type": "string",
          "required": false
        },
        {
          "name": "skipBy",
          "type": "number",
          "required": false,
          "description": "±10s skip step, seconds"
        },
        {
          "name": "onPrev",
          "type": "(() => void)",
          "required": false
        },
        {
          "name": "onNext",
          "type": "(() => void)",
          "required": false
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/audio-player.tsx"
}
