{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "stepper",
  "title": "Stepper",
  "status": "stable",
  "since": "0.4.1",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {},
  "components": [
    {
      "name": "Stepper",
      "props": [
        {
          "name": "steps",
