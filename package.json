{
  "name": "kinetixui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.1+sha512.3c14c15408d1489d350f8ed7f93361d26cc707054f6849a4eea3bb7407ff4fe4564b413a1c421a773a176ab1168a8df1c7d548f2cd0dc7d344f58c4e680a5b18",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:tokens": "node style-dictionary/build.mjs",
    "vendor:compose": "node scripts/vendor-compose-tokens.mjs",
    "vendor:swiftui": "node scripts/vendor-swiftui-tokens.mjs",
    "vendor:flutter": "node scripts/vendor-flutter-tokens.mjs",
    "gen:registry": "node scripts/gen-registry.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:stories": "node scripts/gen-stories.mjs",
    "gen:specs": "node scripts/gen-component-specs.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:icons": "node scripts/check-icon-mapping.mjs",
    "build:registry": "node scripts/gen-registry.mjs && shadcn build registry/registry.json --output apps/web/public/r && node scripts/rewrite-schema.mjs && node scripts/gen-registry-index.mjs && node scripts/gen-component-specs.mjs",
    "build:ui": "pnpm --filter @kinetixui/ui build",
    "build:cli": "pnpm --filter @kinetixui/cli build",
    "storybook": "pnpm --filter @kinetixui/docs storybook",
    "build-storybook": "pnpm --filter @kinetixui/docs build-storybook",
    "dev:web": "pnpm --filter @kinetixui/web dev",
    "build:web": "pnpm --filter @kinetixui/web build",
    "clean": "turbo run clean && rimraf node_modules",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:tokens && pnpm --filter @kinetixui/ui build && pnpm --filter @kinetixui/cli build && pnpm -r publish --no-git-checks --provenance && changeset git-tag && git push --tags"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "rimraf": "^6.1.3",
    "shadcn": "^4.21.0",
    "style-dictionary": "^5.5.3",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  }
}
