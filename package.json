{
  "name": "kinetixui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.1+sha512.3c14c15408d1489d350f8ed7f93361d26cc707054f6849a4eea3bb7407ff4fe4564b413a1c421a773a176ab1168a8df1c7d548f2cd0dc7d344f58c4e680a5b18",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:tokens": "node style-dictionary/build.mjs",
    "vendor:compose": "node scripts/vendor-compose-tokens.mjs",
    "vendor:swiftui": "node scripts/vendor-swiftui-tokens.mjs",
    "vendor:flutter": "node scripts/vendor-flutter-tokens.mjs",
    "gen:registry": "node scripts/gen-registry.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:stories": "node scripts/gen-stories.mjs",
    "check:stories": "node scripts/gen-stories.mjs --check",
    "gen:specs": "node scripts/gen-component-specs.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:a11y-coverage": "node scripts/check-a11y-coverage.mjs",
    "check:token-contract": "node scripts/check-token-contract.mjs",
    "gen:release-meta": "node scripts/gen-release-meta.mjs",
    "check:releases": "node scripts/check-releases.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:swiftui-tokens": "node scripts/check-swiftui-tokens.mjs",
    "check:icons": "node scripts/check-icon-mapping.mjs",
    "check:icon-direction": "node scripts/icon-direction.mjs",
    "gen:keyboard": "node scripts/gen-keyboard.mjs",
    "check:keyboard": "node scripts/gen-keyboard.mjs --check",
    "gen:verification": "node scripts/gen-verification.mjs",
    "check:verification": "node scripts/gen-verification.mjs --check",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "check:manifest": "node scripts/gen-manifest.mjs --check",
    "gen:flagship": "node scripts/gen-flagship-examples.mjs",
    "check:flagship-examples": "node scripts/gen-flagship-examples.mjs --check",
    "check:a11y-browser": "node scripts/a11y-browser.mjs",
    "check:large-text": "node scripts/large-text.mjs",
    "check:motion": "node scripts/motion.mjs",
    "check:loop-motion": "node scripts/loop-motion.mjs",
    "check:card-visual": "node scripts/card-visual.mjs",
    "check:selection-visual": "node scripts/selection-visual.mjs",
    "check:entry-visual": "node scripts/entry-visual.mjs",
    "check:composite-visual": "node scripts/composite-visual.mjs",
    "check:navigation-visual": "node scripts/navigation-visual.mjs",
    "check:overlay-visual": "node scripts/overlay-visual.mjs",
    "check:native-motion": "node scripts/check-native-motion.mjs",
    "check:a11y-site": "node scripts/a11y-site.mjs --base http://127.0.0.1:3000",
    "check:theme-isolation": "node scripts/theme-isolation.mjs --base http://127.0.0.1:3000",
    "check:iot-state-spatial": "node scripts/iot-state-spatial.mjs --base http://127.0.0.1:3000",
    "check:iot-strategies": "node scripts/iot-control-strategies.mjs",
    "check:type-scale": "node scripts/check-type-scale.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:grid": "node scripts/check-grid.mjs",
    "build:registry": "node scripts/gen-registry.mjs && shadcn build registry/registry.json --output apps/web/public/r && node scripts/rewrite-schema.mjs && node scripts/gen-registry-index.mjs && node scripts/gen-component-specs.mjs",
    "check:registry-deps": "node scripts/check-registry-deps.mjs",
    "check:registry-motion": "node scripts/check-registry-motion.mjs",
    "build:ui": "pnpm --filter @kinetixui/ui build",
    "build:cli": "pnpm --filter @kinetixui/cli build",
    "build:iot": "pnpm --filter @kinetixui/iot build",
    "check:iot-dist": "node scripts/check-iot-dist.mjs",
    "storybook": "pnpm --filter @kinetixui/docs storybook",
    "build-storybook": "pnpm --filter @kinetixui/docs build-storybook",
    "dev:web": "pnpm --filter @kinetixui/web dev",
    "build:web": "pnpm --filter @kinetixui/web build",
    "clean": "turbo run clean && rimraf node_modules",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm test:release",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release-publish.mjs",
    "check:platform-completeness": "node scripts/check-platform-completeness.mjs",
    "check:platform-source": "node scripts/check-platform-source.mjs",
    "platform:matrix": "node scripts/check-platform-source.mjs --matrix",
    "report:beta": "node scripts/report-beta.mjs",
    "build:angular": "pnpm --filter @kinetixui/angular build",
    "test:angular": "pnpm --filter @kinetixui/angular test",
    "gen:blocks": "node scripts/gen-block-examples.mjs",
    "check:blocks": "node scripts/gen-block-examples.mjs --check",
    "gen:iot-examples": "node scripts/gen-iot-examples.mjs",
    "check:iot-examples": "node scripts/gen-iot-examples.mjs --check",
    "check:block-source": "node scripts/check-block-source.mjs",
    "gen:usage": "node scripts/gen-usage-examples.mjs",
    "check:usage": "node scripts/gen-usage-examples.mjs --check",
    "check:platform-code": "node scripts/check-platform-code.mjs",
    "marketing:stats": "node scripts/marketing-stats.mjs",
    "marketing:release-notes": "node scripts/release-to-content.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release": "node scripts/release/test/run.mjs",
    "check:angular-package": "node scripts/angular-package/check.mjs",
    "gen:angular-api": "node scripts/angular-package/api-snapshot.mjs",
    "check:angular-api": "node scripts/angular-package/api-snapshot.mjs --check",
    "check:angular-graduation": "node scripts/check-angular-graduation.mjs",
    "check:angular-browser": "node scripts/angular-browser.mjs",
    "check:angular-overlays": "node scripts/angular-overlays.mjs",
    "check:content": "node scripts/check-content-register.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "check:analytics-browser": "node scripts/analytics-browser.mjs --base http://127.0.0.1:3100",
    "gen:visuals": "node scripts/gen-marketing-visuals.mjs",
    "render:visuals": "node scripts/render-marketing-visuals.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "shadcn": "^4.21.0",
    "style-dictionary": "^5.5.5",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3"
  }
}
