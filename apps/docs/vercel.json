{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "storybook",
  "buildCommand": "cd ../.. && pnpm build:tokens && pnpm --filter @kinetixui/docs build-storybook",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "outputDirectory": "storybook-static",
  "git": {
    "deploymentEnabled": {
      "codex/m62-swiftui-toast-cancellation": false,
      "codex/m63-swiftui-toast-identity": false,
      "ZedX/m66-ios-toast-passive": false
    }
  }
}
