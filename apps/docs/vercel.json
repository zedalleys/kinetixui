{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "storybook",
  "buildCommand": "cd ../.. && pnpm build:tokens && pnpm --filter @kinetixui/docs build-storybook",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "outputDirectory": "storybook-static",
  "git": {
    "deploymentEnabled": {
      "codex/m68-angular-motion": false,
      "codex/m68-compose-selection": false,
      "codex/m68-flutter-selection-accessibility": false
    }
  }
}
