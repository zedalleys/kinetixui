# Copy to .env.local (git-ignored) for local use. In production these live in the Vercel project settings.
# Both are optional: with either one missing or malformed, analytics is simply off. See ANALYTICS.md.

# PostHog project API key — the public "phc_…" key, not a personal API key. Do not commit a real value.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingest host, an https origin with no path:
#   US cloud: https://us.i.posthog.com      EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# Local verification of the analytics pipeline ONLY (with `next build && next start`): skip the check that the
# page is on kinetixui.com. Leave unset everywhere else — it exists so previews and localhost never send.
# NEXT_PUBLIC_ANALYTICS_ANY_HOST=true
