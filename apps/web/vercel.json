{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm build:tokens && pnpm --filter @kinetixui/ui build && pnpm build:iot && pnpm --filter @kinetixui/web build",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "codex/precision-native-20261110": false,
      "codex/value-motion-20261110": false
    }
  }
}
