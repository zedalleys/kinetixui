          "required": false,
          "description": "hide the leading intent icon"
        },
        {
          "name": "intent",
          "type": "\"success\" | \"warning\" | \"info\" | \"error\" | null",
          "required": false
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/field.tsx"
