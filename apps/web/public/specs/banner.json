        },
        {
          "name": "action",
          "type": "{ label: React.ReactNode; onClick?: () => void; }",
          "required": false,
          "description": "optional CTA rendered inline after the message"
        },
        {
          "name": "variant",
          "type": "\"success\" | \"warning\" | \"information\" | \"error\" | \"action\" | null",
          "required": false
        },
        {
          "name": "sticky",
          "type": "boolean | null",
          "required": false
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/banner.tsx"
}
