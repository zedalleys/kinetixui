{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "description-list",
  "title": "Description List",
  "status": "stable",
  "since": "0.10.0",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {},
  "components": [
    {
      "name": "DescriptionList",
      "props": []
    },
    {
      "name": "DescriptionListItem",
      "props": [
        {
          "name": "term",
          "type": "React.ReactNode",
          "required": true
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": true
        },
        {
          "name": "layout",
          "type": "\"row\" | \"stacked\"",
          "required": false,
          "description": "`row` (default) puts the term and value side by side; `stacked` puts the value below a full-width term — better for long values."
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/description-list.tsx"
}
