{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "date-picker",
  "title": "Date Picker",
  "status": "stable",
  "since": "0.4.1",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {},
  "components": [
    {
      "name": "DatePicker",
      "props": [
        {
          "name": "value",
          "type": "Date",
          "required": false
        },
        {
