{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "inform",
  "title": "Inform",
  "status": "stable",
  "since": "0.4.1",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {
    "variant": [
      "information",
      "warning",
      "success",
      "error",
      "action"
    ]
  },
  "components": [
    {
      "name": "Inform",
      "props": [
        {
          "name": "hideIcon",
          "type": "boolean",
          "required": false
        },
        {
          "name": "onDismiss",
          "type": "(() => void)",
          "required": false
        },
        {
          "name": "action",
          "type": "{ label: React.ReactNode; onClick?: () => void; icon?: React.ReactNode; }",
          "required": false,
          "description": "optional CTA rendered below the message"
        },
        {
          "name": "variant",
          "type": "\"success\" | \"warning\" | \"information\" | \"error\" | \"action\" | null",
          "required": false
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/inform.tsx"
}
