{
  "$schema": "https://kinetixui.com/schema/component-spec.json",
  "name": "carousel",
  "title": "Carousel",
  "status": "stable",
  "since": "0.4.1",
  "platforms": [
    "React",
    "SwiftUI",
    "Compose",
    "Flutter"
  ],
  "variants": {},
  "components": [
    {
      "name": "Carousel",
      "props": [
        {
          "name": "opts",
          "type": "Partial<OptionsType>",
          "required": false
        },
        {
          "name": "plugins",
          "type": "CreatePluginType<LoosePluginType, {}>[]",
          "required": false
        },
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "required": false
        },
        {
          "name": "setApi",
          "type": "((api: CarouselApi) => void)",
          "required": false
        }
      ]
    },
    {
      "name": "CarouselContent",
      "props": []
    },
    {
      "name": "CarouselItem",
      "props": []
    },
    {
      "name": "CarouselPrevious",
      "props": [
        {
          "name": "asChild",
          "type": "boolean",
          "required": false,
          "description": "render as the single child element (Radix Slot) instead of <button>"
        },
        {
          "name": "variant",
          "type": "\"Primary\" | \"Secondary\" | \"Outline\" | \"Destructive\" | \"Ghost\" | \"Link\" | null",
          "required": false
        },
        {
          "name": "size",
          "type": "\"sm\" | \"md\" | \"lg\" | \"icon\" | null",
          "required": false
        },
        {
          "name": "state",
          "type": "\"Default\" | \"Hover\" | \"Focus\" | \"Active\" | \"Disabled\" | null",
          "required": false,
          "description": "force a static visual state — leave undefined for real interaction"
        },
        {
          "name": "corners",
          "type": "\"default\" | \"sharp\" | \"pill\" | null",
          "required": false,
          "description": "corner style — matches the design source's Corners property"
        }
      ]
    },
    {
      "name": "CarouselNext",
      "props": [
        {
          "name": "asChild",
          "type": "boolean",
          "required": false,
          "description": "render as the single child element (Radix Slot) instead of <button>"
        },
        {
          "name": "variant",
          "type": "\"Primary\" | \"Secondary\" | \"Outline\" | \"Destructive\" | \"Ghost\" | \"Link\" | null",
          "required": false
        },
        {
          "name": "size",
          "type": "\"sm\" | \"md\" | \"lg\" | \"icon\" | null",
          "required": false
        },
        {
          "name": "state",
          "type": "\"Default\" | \"Hover\" | \"Focus\" | \"Active\" | \"Disabled\" | null",
          "required": false,
          "description": "force a static visual state — leave undefined for real interaction"
        },
        {
          "name": "corners",
          "type": "\"default\" | \"sharp\" | \"pill\" | null",
          "required": false,
          "description": "corner style — matches the design source's Corners property"
        }
      ]
    }
  ],
  "source": "packages/ui/src/components/carousel.tsx"
}
