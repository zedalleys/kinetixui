{
  "name": "@kinetixui/iot",
  "version": "0.5.0",
  "private": false,
  "description": "KinetixUI IoT — a connected-device module for building products that pair, monitor, control and troubleshoot devices. Experimental.",
  "keywords": [
    "iot",
    "connected-devices",
    "telemetry",
    "device-status",
    "react",
    "design-system",
    "kinetixui"
  ],
  "license": "MIT",
  "author": "KinetixUI",
  "homepage": "https://kinetixui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zedalleys/kinetixui.git",
    "directory": "packages/iot"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/functions/index.ts src/react/index.ts --format esm --dts --clean --external react --external react-dom",
    "lint": "eslint src reference",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
