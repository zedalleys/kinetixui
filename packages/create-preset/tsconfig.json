{
  "compilerOptions": {
    "target": "ES2022",
    // No "dom" and no "node": the codec has to compile against neither, which is what keeps it usable
    // from the website, the CLI and a future exporter without a build flag choosing between them.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
