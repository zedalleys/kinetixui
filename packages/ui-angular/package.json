{
  "name": "@kinetixui/angular",
  "version": "0.25.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "KinetixUI for Angular — standalone components built on the same generated design tokens as the React, SwiftUI, Jetpack Compose and Flutter implementations.",
  "license": "MIT",
  "homepage": "https://kinetixui.com/docs/angular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zedalleys/kinetixui.git",
    "directory": "packages/ui-angular"
  },
  "keywords": [
    "angular",
    "design-system",
    "components",
    "design-tokens",
    "accessibility"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node scripts/check-dist.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@kinetixui/tokens": ">=0.24.0 <0.25.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@angular/build": "21.2.24",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@kinetixui/tokens": "workspace:*",
    "jsdom": "^28.0.0",
    "ng-packagr": "21.2.7",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "zone.js": "^0.16.3"
  },
  "exports": {
    "./styles.css": {
      "default": "./styles.css"
    }
  }
