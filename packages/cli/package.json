{
  "name": "@kinetixui/cli",
  "version": "0.24.0",
  "description": "Add KinetixUI components and tokens to your project.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://kinetixui.com",
  "repository": "zedalleys/kinetixui",
  "bin": {
    "kinetixui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess \"node dist/index.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@kinetixui/create-preset": "workspace:*",
    "@kinetixui/create-theme": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/prompts": "^2.4.9",
    "jsdom": "^30.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
