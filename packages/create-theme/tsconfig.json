{
  "compilerOptions": {
    "target": "ES2022",
    // No "dom": the engine resolves colours and numbers, and must compile the same whether it is loaded
    // by the website, the CLI or an exporter that runs in neither. "node" is in `types` only for the two
    // test files that read the generated stylesheet off disk to prove the ladder has not drifted.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
