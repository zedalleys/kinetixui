{
  "color": {
    "background": {
      "$value": "{color.neutral.0}",
      "$type": "color",
      "$description": "figma: surfaceContainerLowest #ffffff"
    },
    "foreground": {
      "$value": "{color.blue.900}",
      "$type": "color",
      "$description": "figma: onSurface #050c11"
    },
    "card": {
      "$value": "{color.neutral.0}",
      "$type": "color",
      "$description": "synth: no Figma card token; = background"
    },
    "card-foreground": {
      "$value": "{color.blue.900}",
      "$type": "color",
      "$description": "synth: = foreground"
    },
    "popover": {
      "$value": "{color.neutral.0}",
      "$type": "color",
      "$description": "synth: no Figma popover token; = background"
    },
    "popover-foreground": {
      "$value": "{color.blue.900}",
      "$type": "color",
      "$description": "synth: = foreground"
    },
    "primary": {
      "$value": "#1d4ed8",
      "$type": "color",
      "$description": "was Figma 'Primay' navy (blue.500 -> blue.700). Swapped for a bright action blue #1d4ed8 (6.55:1 on bg) so primary buttons/links pop rather than reading as near-black. Dark uses a lighter step (#60a5fa) — navy/this hue would fail on the dark surface."
    },
    "primary-foreground": {
      "$value": "{color.blue.50}",
      "$type": "color",
      "$description": "figma: 'On Primary' #f0f7ff -> renamed primary-foreground (on #1d4ed8 primary ~6:1)"
    },
    "secondary": {
      "$value": "{color.green.200}",
      "$type": "color",
      "$description": "figma secondaryContainer was green.50 #f1f3f1 (invisible on bg); deepened to green.200 #c7cfc7 so a secondary button/chip clearly stands off the white page — same sage hue"
    },
    "secondary-foreground": {
      "$value": "{color.green.700}",
      "$type": "color",
      "$description": "green.700 #465245 on secondary green.200 #c7cfc7 clears ~5.2:1"
    },
    "muted": {
      "$value": "{color.neutral.100}",
      "$type": "color",
      "$description": "figma: surfaceContainer #f6f6f6"
    },
    "muted-foreground": {
      "$value": "{color.neutral.600}",
      "$type": "color",
      "$description": "figma: onSurfaceVariant #6d6d6d"
    },
    "accent": {
      "$value": "{color.blue.50}",
      "$type": "color",
      "$description": "figma: 'LightBlue' #f0f7ff (the hover fill used by Outline/Ghost buttons)"
    },
    "accent-foreground": {
      "$value": "#1d4ed8",
      "$type": "color",
      "$description": "synth: = primary for readable text on accent (#1d4ed8 on accent #f0f7ff ~5.7:1)"
    },
    "destructive": {
      "$value": "{color.red.500}",
      "$type": "color",
      "$description": "a11y: figma error #ec5047 is 3.33:1 under on-error / 3.62:1 as text on the page — fails WCAG AA. red.500 #c60a0a clears 5.6:1 / 6.1:1. See ACCESSIBILITY-AUDIT.md."
    },
    "destructive-foreground": {
      "$value": "{color.semantic.on-error}",
      "$type": "color",
      "$description": "figma: onError #fef3f2"
    },
    "success": {
      "$value": "{color.green.600}",
      "$type": "color",
      "$description": "synth: no Figma success token; green ramp step 6 (distinct from secondary)"
    },
    "success-foreground": {
      "$value": "{color.green.50}",
      "$type": "color",
      "$description": "synth"
    },
    "warning": {
      "$value": "{color.amber.800}",
      "$type": "color",
      "$description": "a11y: Figma onWarningContainer #f97907 is 2.7:1 as text on the page / 2.6:1 in the Tag warning variant — fails WCAG AA. amber.800 #7f5b21 clears 6.1:1 / 5.8:1. Dark --warning stays bright (amber.400). See ACCESSIBILITY-AUDIT.md."
    },
    "warning-foreground": {
      "$value": "{color.semantic.warning-container}",
      "$type": "color",
      "$description": "figma: warningContainer #fff8eb"
    },
    "border": {
      "$value": "{color.blue.100}",
      "$type": "color",
      "$description": "figma: outline #92b2c8"
    },
    "input": {
      "$value": "{color.blue.100}",
      "$type": "color",
      "$description": "figma: outline #92b2c8 (same as border)"
    },
    "ring": {
      "$value": "#1d4ed8",
      "$type": "color",
      "$description": "focus ring — tracks --primary (#1d4ed8, 6.55:1 on bg)"
    },
    "semantic": {
      "error": {
        "$value": "#ec5047",
        "$type": "color",
        "$description": "figma: error (NOT red.500 #c60a0a — Figma keeps error as its own value)"
      },
      "on-error": {
        "$value": "#fef3f2",
        "$type": "color",
        "$description": "figma: onError"
      },
      "error-container": {
        "$value": "#fef3f2",
        "$type": "color",
        "$description": "figma: errorContainer"
      },
      "on-error-container": {
        "$value": "#ec5047",
        "$type": "color",
        "$description": "figma: onErrorContainer"
      },
      "warning-container": {
        "$value": "#fff8eb",
        "$type": "color",
        "$description": "figma: warningContainer"
      },
      "on-warning-container": {
        "$value": "#f97907",
        "$type": "color",
        "$description": "figma: onWarningContainer"
      },
      "success-container": {
        "$value": "#f1f3f1",
        "$type": "color"
      },
      "on-success-container": {
        "$value": "#465245",
        "$type": "color"
      },
      "warning": {
        "$value": "#f97907",
        "$type": "color"
      },
      "info-container": {
        "$value": "#f0f7ff",
        "$type": "color"
      },
      "on-info-container": {
        "$value": "#395a70",
        "$type": "color"
      }
    },
    "chart-1": {
      "$value": "{color.blue.500}",
      "$type": "color",
      "$description": "synth: brand ramps for data viz"
    },
    "chart-2": {
      "$value": "{color.green.500}",
      "$type": "color"
    },
    "chart-3": {
      "$value": "{color.amber.500}",
      "$type": "color"
    },
    "chart-4": {
      "$value": "{color.red.400}",
      "$type": "color"
    },
    "chart-5": {
      "$value": "{color.taupe.600}",
      "$type": "color"
    },
    "chart-6": {
      "$value": "{color.blue.300}",
      "$type": "color",
      "$description": "synth: 6th data-viz hue — steel blue, distinct from the navy chart-1"
    },
    "chart-7": {
      "$value": "{color.red.600}",
      "$type": "color",
      "$description": "synth: 7th data-viz hue — deep red, distinct from chart-4"
    },
    "chart-8": {
      "$value": "{color.green.700}",
      "$type": "color",
      "$description": "synth: 8th data-viz hue — deep green, distinct from chart-2"
    },
    "sidebar": {
