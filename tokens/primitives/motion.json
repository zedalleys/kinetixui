    },
    "slower": {
      "$type": "duration",
      "$value": "1000ms",
      "$description": "Looping animations — caret blink."
    }
  },
  "easing": {
    "linear": {
      "$type": "cubicBezier",
      "$value": [0, 0, 1, 1],
      "$description": "Constant-speed motion — panel slides (Sidebar)."
