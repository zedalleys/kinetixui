{
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "Quick UI transitions — icon rotation, chevrons, sidebar collapse."
    },
    "base": {
      "$type": "duration",
      "$value": "300ms",
      "$description": "Default transition speed — fades, stroke/progress animations."
    },
    "slow": {
      "$type": "duration",
      "$value": "500ms",
