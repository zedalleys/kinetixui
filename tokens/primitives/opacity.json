{
  "opacity": {
    "hidden": {
      "$type": "number",
      "$value": 0,
      "$description": "Fully transparent."
    },
    "disabled": {
      "$type": "number",
      "$value": 0.5,
      "$description": "Disabled-state dimming for interactive controls."
    },
    "muted": {
      "$type": "number",
