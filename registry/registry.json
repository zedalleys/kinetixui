{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "strata",
  "homepage": "https://strata.design",
  "items": [
    {
      "name": "tokens",
      "type": "registry:style",
      "title": "Strata token contract",
      "description": "Semantic CSS variable contract (light + dark) generated by Style Dictionary from the Figma design system.",
      "files": [
        { "path": "registry/strata/globals.css", "type": "registry:file", "target": "app/globals.css" }
      ],
      "cssVars": {
        "light": {
          "background": "#ffffff", "foreground": "#050c11",
          "primary": "#1b3c53", "primary-foreground": "#f0f7ff",
          "secondary": "#f1f3f1", "secondary-foreground": "#748873",
          "muted": "#f6f6f6", "muted-foreground": "#6d6d6d",
          "accent": "#f0f7ff", "accent-foreground": "#1b3c53",
          "destructive": "#ec5047", "destructive-foreground": "#fef3f2",
          "border": "#92b2c8", "input": "#92b2c8", "ring": "#1b3c53",
          "radius": "8px"
        },
        "dark": {
          "background": "#050c11", "foreground": "#f0f7ff",
          "primary": "#92b2c8", "primary-foreground": "#050c11",
          "secondary": "#2e362e", "secondary-foreground": "#e3e7e3",
          "muted": "#102432", "muted-foreground": "#92b2c8",
          "accent": "#102432", "accent-foreground": "#f0f7ff",
          "destructive": "#dd6a6a", "destructive-foreground": "#280202",
          "border": "#395a70", "input": "#395a70", "ring": "#92b2c8"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "6 variants x 4 sizes x 5 states, generated 1:1 from Figma node 54863:351.",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority", "clsx", "tailwind-merge"],
      "registryDependencies": ["tokens"],
      "files": [
        { "path": "registry/strata/ui/button.tsx", "type": "registry:ui", "target": "components/ui/button.tsx" },
        { "path": "registry/strata/lib/utils.ts", "type": "registry:lib", "target": "lib/utils.ts" }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "Text input, generated 1:1 from Figma node 54855:13836 (state: Default | Focus | Error | Disabled).",
      "dependencies": ["class-variance-authority", "clsx", "tailwind-merge"],
      "registryDependencies": ["tokens"],
      "files": [
        { "path": "registry/strata/ui/input.tsx", "type": "registry:ui", "target": "components/ui/input.tsx" },
        { "path": "registry/strata/lib/utils.ts", "type": "registry:lib", "target": "lib/utils.ts" }
      ]
    },
    {
      "name": "textarea",
      "type": "registry:ui",
      "title": "Textarea",
      "description": "Multi-line text input, generated 1:1 from Figma node 54855:13857 (state: Default | Focus | Error | Disabled).",
      "dependencies": ["class-variance-authority", "clsx", "tailwind-merge"],
      "registryDependencies": ["tokens"],
      "files": [
        { "path": "registry/strata/ui/textarea.tsx", "type": "registry:ui", "target": "components/ui/textarea.tsx" },
        { "path": "registry/strata/lib/utils.ts", "type": "registry:lib", "target": "lib/utils.ts" }
      ]
    }
  ]
}
